# DeepSeek 生成 + 硅基流动 BGE 嵌入/重排序。
# 填写下列 Key 和身份映射后，再将这些字段合并到项目根目录 .env。
# 请保留已有 .env 中的凭证；此文件本身不会被程序自动加载。
DEMO_MODE=false
DATA_DIR=data_deepseek

LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_STRUCTURED_METHOD=json_mode
LLM_THINKING=disabled
LLM_REVISION=operator-configured

EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_REVISION=main

RERANKER_PROVIDER=http
RERANKER_URL=https://api.siliconflow.cn/v1/rerank
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_API_KEY=
RERANKER_REVISION=main

# 两个 BGE Key 可以填写同一个硅基流动账户的 API Key。
# 这是本系统自己的访问令牌，不是任何模型平台的 Key。
# 例如 '{"自己生成的随机长令牌":{"user_id":"local-admin","role":"admin","organization":"demo-bank"}}'
API_AUTH_TOKENS_JSON=
API_URL=http://127.0.0.1:8000
TOKENIZER_MODEL=
MAX_OUTPUT_TOKENS=2000
REQUEST_TIMEOUT=60
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
