# 先以教学模式运行，全部 Key 可以留空。接真实模型时设 DEMO_MODE=false。
DEMO_MODE=true
DATA_DIR=data

# 兼容 OpenAI Chat Completions 的服务，例如本地 Qwen/vLLM 或经批准的云服务。
LLM_BASE_URL=http://localhost:8001/v1
LLM_MODEL=Qwen/Qwen3-8B
LLM_API_KEY=
LLM_REVISION=operator-configured
LLM_STRUCTURED_METHOD=json_mode
# DeepSeek 建议 disabled，避免较小输出预算被模型思考占用；其他服务默认 auto。
LLM_THINKING=auto
# 可选：填本地路径/模型名并安装 .[local]，使用生成模型实际 tokenizer。
# 未配置时用 UTF-8 字节数作保守上下文预算，非精确 token 计费。
TOKENIZER_MODEL=
TOKENIZER_REVISION=main

# 使用 /embeddings 服务；本地模型改 EMBEDDING_PROVIDER=local 并安装 .[local]。
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=http://localhost:8002/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_REVISION=main

# lexical 是仅用于基线的词法重排；真实 BGE 可选 local 或 http。
RERANKER_PROVIDER=http
RERANKER_URL=http://localhost:8003/v1/rerank
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_API_KEY=
RERANKER_REVISION=main

# 服务端身份映射。填 JSON：token -> user_id / role / organization。
# 例如：'{"替换为随机员工令牌":{"user_id":"alice","role":"employee","organization":"demo-bank"},"替换为随机管理员令牌":{"user_id":"admin","role":"admin","organization":"demo-bank"}}'
# 非教学模式必须填写；教学模式未填写时只开放匿名员工问答，不开放管理员操作。
API_AUTH_TOKENS_JSON=
API_URL=http://127.0.0.1:8000

REQUEST_TIMEOUT=60
CHUNK_SIZE=600
CHUNK_OVERLAP=80
RETRIEVAL_K=20
RERANK_K=30
EVIDENCE_K=8
MAX_SUPPLEMENT_ROUNDS=2
MAX_SUBQUESTIONS=4
MAX_CONTEXT_TOKENS=6000
MAX_OUTPUT_TOKENS=1500

# 如自行启用 LangSmith，请评估会上传的正文与提示词；默认关闭。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
